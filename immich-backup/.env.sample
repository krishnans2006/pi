# Immich media root. This includes Immich's database-backup directory.
UPLOAD_LOCATION=/data/immich/media

# Destination inside Google Drive. Keep the gdrive: prefix.
RCLONE_REMOTE_PATH=gdrive:Backups/Immich

# Credentials for a Google OAuth "Desktop app".
GOOGLE_DRIVE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET='CHANGE_ME'

# JSON printed by the authorization command documented in README.md.
GOOGLE_DRIVE_TOKEN='PASTE_THE_JSON_TOKEN_HERE'

# Use two different, long random values and save them in a password manager.
# Both values are required to decrypt a restore.
RCLONE_CRYPT_PASSWORD='CHANGE_ME_TO_A_LONG_RANDOM_PASSPHRASE'
RCLONE_CRYPT_SALT='CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_VALUE'

# Run immediately at container startup, then once per day.
BACKUP_INTERVAL_SECONDS=86400

# Retry sooner after an unsuccessful run.
BACKUP_RETRY_INTERVAL_SECONDS=3600
